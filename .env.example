# OpenAI API key — used by default for text, scene/cover art (gpt-image-2),
# and character portraits (gpt-image-2)
OPENAI_API_KEY=sk-...

# Optional: pick the text LLM provider. One of: openai | openrouter | ollama
# (Defaults to openai. Settings screen can also persist this per user.)
# STORYGEN_TEXT_PROVIDER=openai

# Optional: API key for OpenRouter (required when STORYGEN_TEXT_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# Optional: override default text model (defaults to gpt-4o-mini)
# STORYGEN_TEXT_MODEL=gpt-4o-mini

# Optional: override default text base URL. Useful for provider-specific endpoints:
#   OpenAI:     https://api.openai.com/v1   (default)
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
# STORYGEN_TEXT_BASE_URL=https://api.openai.com/v1

# Scene/cover art provider config (defaults to openai / gpt-image-2)
# One of: openai | gemini | zai | ollama
# STORYGEN_IMAGE_PROVIDER=openai
# STORYGEN_IMAGE_MODEL=gpt-image-2

# Optional: override scene/cover art API key (falls back to the provider's standard key,
# e.g. OPENAI_API_KEY for OpenAI, GEMINI_API_KEY for Gemini, ZAI_API_KEY for Z.AI)
# STORYGEN_IMAGE_API_KEY=sk-...

# Optional: override scene/cover art base URL (defaults to provider-specific endpoint;
# OpenAI uses https://api.openai.com/v1)
# STORYGEN_IMAGE_BASE_URL=https://api.openai.com/v1

# Character portrait provider config (defaults to openai / gpt-image-2)
# One of: openai | gemini | zai | ollama
# STORYGEN_CHARACTER_IMAGE_PROVIDER=openai
# STORYGEN_CHARACTER_IMAGE_MODEL=gpt-image-2

# Optional: override character portrait API key (falls back to the provider's standard key,
# e.g. OPENAI_API_KEY for OpenAI, GEMINI_API_KEY for Gemini, ZAI_API_KEY for Z.AI)
# STORYGEN_CHARACTER_IMAGE_API_KEY=sk-...

# Optional: override character portrait base URL (defaults to provider-specific endpoint;
# OpenAI uses https://api.openai.com/v1)
# STORYGEN_CHARACTER_IMAGE_BASE_URL=https://api.openai.com/v1

# Gemini API key (required when either image provider is gemini)
# GEMINI_API_KEY=...

# Z.AI API key (required when either image provider is zai)
# ZAI_API_KEY=...

# Ollama requires no API key — pull an image model with: ollama pull x/z-image-turbo

# ---------------------------------------------------------------------------
# FastAPI server (optional `[api]` extra; `storygen-api serve` / `make api-dev`)
# ---------------------------------------------------------------------------
# Shared bearer token for the API surface (SEC-001). Two modes:
#  - UNSET (default): loopback peers (127.x / ::1) are trusted, so local dev
#    (`make api-dev` + `make web-dev`) works with no token; off-box clients
#    are rejected with HTTP 503 / WebSocket close 4403 (fail-closed).
#  - SET: every client — loopback included — must send the matching bearer
#    token. Required before binding to a non-loopback interface (e.g. LAN).
# Generate one with, e.g., `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# and pass it to clients as `Authorization: Bearer <token>` (HTTP) or via the
# `Sec-WebSocket-Protocol: bearer.<token>` subprotocol (WebSocket).
# STORYGEN_API_TOKEN=

# CORS origins allowed by the API (SEC-008). Comma-separated; defaults to the
# web dev server origins. Change this when deploying the frontend elsewhere.
# STORYGEN_API_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# WebSocket handshake origin allowlist (SEC-011). Comma-separated; defaults
# mirror STORYGEN_API_ALLOWED_ORIGINS. Browser WS clients must send an Origin
# on this list (non-browser clients are unaffected — bearer auth gates them).
# STORYGEN_WS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# Per-IP sliding-window limit on cost-incurring routes (SEC-007), format
# <count>/<period> with period in {second, minute, hour}. Default 30/minute.
# Read-only GETs are not throttled. Set count to 0 to disable the limiter.
# STORYGEN_API_RATE_LIMIT=30/minute

# ---------------------------------------------------------------------------
# Text-to-speech provider keys (optional; configured via the Settings screen).
# par-storygen uses par-cli-tts, which supports OpenAI, ElevenLabs, Deepgram,
# Google Gemini, and Kokoro (local, no key). The OpenAI and Gemini keys above
# are reused for their respective TTS providers; ElevenLabs and Deepgram need
# their own. Kokoro runs locally and needs no key.
# ELEVENLABS_API_KEY=...
# DEEPGRAM_API_KEY=...
