# OpenAI API key — used for text (default) and image (gpt-image-2) generation
OPENAI_API_KEY=sk-...

# Optional: pick the text LLM provider. One of: openai | openrouter | ollama
# (Defaults to openai. Settings screen can also persist this per user.)
# STORYGEN_TEXT_PROVIDER=openai

# Optional: API key for OpenRouter (required when STORYGEN_TEXT_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# Optional: override default text model (defaults to gpt-4o-mini)
# STORYGEN_TEXT_MODEL=gpt-4o-mini

# Optional: override default text base URL. Useful for provider-specific endpoints:
#   OpenAI:     https://api.openai.com/v1   (default)
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
# STORYGEN_TEXT_BASE_URL=https://api.openai.com/v1

# Optional: pick an image provider (defaults to openai)
# One of: openai | gemini | zai | ollama
# STORYGEN_IMAGE_PROVIDER=openai

# Gemini API key (required when STORYGEN_IMAGE_PROVIDER=gemini)
# GEMINI_API_KEY=...

# Z.AI API key (required when STORYGEN_IMAGE_PROVIDER=zai)
# ZAI_API_KEY=...

# Ollama requires no API key — pull an image model with: ollama pull x/z-image-turbo

# Optional: override image model (defaults to gpt-image-2)
# STORYGEN_IMAGE_MODEL=gpt-image-2

# Optional: override image API key (falls back to OPENAI_API_KEY)
# Useful when text uses a custom provider (e.g. z.ai, OpenRouter) but images need real OpenAI
# STORYGEN_IMAGE_API_KEY=sk-...

# Optional: override image base URL (defaults to OpenAI's https://api.openai.com/v1)
# STORYGEN_IMAGE_BASE_URL=https://api.openai.com/v1
