# OpenAI API key — used by default for text, scene/cover art (gpt-image-2),
# and character portraits (gpt-image-2)
OPENAI_API_KEY=sk-...

# Optional: pick the text LLM provider. One of: openai | openrouter | ollama
# (Defaults to openai. Settings screen can also persist this per user.)
# STORYGEN_TEXT_PROVIDER=openai

# Optional: API key for OpenRouter (required when STORYGEN_TEXT_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# Optional: override default text model (defaults to gpt-4o-mini)
# STORYGEN_TEXT_MODEL=gpt-4o-mini

# Optional: override default text base URL. Useful for provider-specific endpoints:
#   OpenAI:     https://api.openai.com/v1   (default)
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
# STORYGEN_TEXT_BASE_URL=https://api.openai.com/v1

# Scene/cover art provider config (defaults to openai / gpt-image-2)
# One of: openai | gemini | zai | ollama
# STORYGEN_IMAGE_PROVIDER=openai
# STORYGEN_IMAGE_MODEL=gpt-image-2

# Optional: override scene/cover art API key (falls back to the provider's standard key,
# e.g. OPENAI_API_KEY for OpenAI, GEMINI_API_KEY for Gemini, ZAI_API_KEY for Z.AI)
# STORYGEN_IMAGE_API_KEY=sk-...

# Optional: override scene/cover art base URL (defaults to provider-specific endpoint;
# OpenAI uses https://api.openai.com/v1)
# STORYGEN_IMAGE_BASE_URL=https://api.openai.com/v1

# Character portrait provider config (defaults to openai / gpt-image-2)
# One of: openai | gemini | zai | ollama
# STORYGEN_CHARACTER_IMAGE_PROVIDER=openai
# STORYGEN_CHARACTER_IMAGE_MODEL=gpt-image-2

# Optional: override character portrait API key (falls back to the provider's standard key,
# e.g. OPENAI_API_KEY for OpenAI, GEMINI_API_KEY for Gemini, ZAI_API_KEY for Z.AI)
# STORYGEN_CHARACTER_IMAGE_API_KEY=sk-...

# Optional: override character portrait base URL (defaults to provider-specific endpoint;
# OpenAI uses https://api.openai.com/v1)
# STORYGEN_CHARACTER_IMAGE_BASE_URL=https://api.openai.com/v1

# Gemini API key (required when either image provider is gemini)
# GEMINI_API_KEY=...

# Z.AI API key (required when either image provider is zai)
# ZAI_API_KEY=...

# Ollama requires no API key — pull an image model with: ollama pull x/z-image-turbo
