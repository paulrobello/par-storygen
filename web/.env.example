# par-storygen web frontend — environment variables.
#
# All vars are NEXT_PUBLIC_*, so they are inlined into the client bundle at
# build time (next build / next dev). Set them before `npm run dev` / `npm run
# build`, or in a deployment via the host's environment. Copy this file to
# `.env.local` (never committed) and edit values there.

# Base URL of the par-storygen FastAPI server. Defaults to the local dev
# server (`make api-dev` on :8101). Override when the API is served from a
# different host/port.
NEXT_PUBLIC_API_BASE=http://localhost:8101

# Optional bearer token sent on every REST request (Authorization header) and
# offered as the WebSocket subprotocol (SEC-102). Required ONLY when the API
# server has STORYGEN_API_TOKEN configured; leave unset for local loopback dev
# (the server trusts loopback peers when no token is set).
#
# IMPORTANT: this value is embedded in the client bundle — appropriate for a
# self-hosted single-user deployment but NOT a secret from anyone who can load
# the page. Generate the matching server token with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and set STORYGEN_API_TOKEN on the API server to the SAME value.
# NEXT_PUBLIC_API_TOKEN=
